<?xml version="1.0" encoding="utf-8"?>
<!-- 5.7.0 u48: a liked artist in Liked > Artists: the same filled row as a song (10dp padding,
     44dp picture, 15sp / 13sp text), with a round photo (or their first letter) so it reads as an
     artist. Tapping it opens the Artist page. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/liked_artist_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:tag="fill:soft">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <TextView
                android:id="@+id/liked_artist_letter"
                style="@style/MinimText.Bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_circle"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:tag="text:bg fill:fg"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/liked_artist_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/liked_artist_name"
                style="@style/MinimText.Semi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text:fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/liked_artist_count"
                style="@style/MinimText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="text:fg"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
