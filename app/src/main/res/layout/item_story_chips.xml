<?xml version="1.0" encoding="utf-8"?>
<!-- 5.7.0 u46: chips under the channel row. u47: "New to You" first, then the two lengths. New to
     You swaps the shelves for picks from other channels; a length chip filters whatever shows. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingBottom="22dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/story_chip_new"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/tapes_chip_new"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/story_chip_short"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/stories_chip_short"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/story_chip_long"
            style="@style/MinimText"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/stories_chip_long"
            android:textSize="12sp" />
    </LinearLayout>
</HorizontalScrollView>
