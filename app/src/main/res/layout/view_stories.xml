<?xml version="1.0" encoding="utf-8"?>
<!-- 5.7.0 u44: the stories tab (was Lab). YouTube channels you add; their uploads, newest first and
     all channels mixed, play as audio only. "+ Add Channel" sits where the other tabs have Search. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_stories"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:orientation="vertical"
    android:tag="bg"
    android:visibility="gone">

    <include
        android:id="@+id/stories_top"
        layout="@layout/view_top_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/stories_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.minim.music.ui.FadingRecyclerView
                android:id="@+id/stories_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="24dp"
                android:paddingBottom="120dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- No channel yet: a big headline like the welcome screens, and the same pill -->
        <LinearLayout
            android:id="@+id/stories_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="72dp"
            android:paddingEnd="36dp"
            android:visibility="gone">

            <TextView
                style="@style/MinimText.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="0.86"
                android:tag="text:fg"
                android:text="@string/stories_empty_title"
                android:textSize="38sp" />

            <TextView
                style="@style/MinimText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:lineSpacingMultiplier="1.1"
                android:tag="text:muted"
                android:text="@string/stories_empty_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/stories_empty_add"
                style="@style/MinimText.Semi"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/shape_pill"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:tag="fill:fg text:bg"
                android:text="@string/add_channel_pill"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
